#!/usr/bin/env bash
# shellcheck shell=bash
#
# diary: the filesystem side of the Omarchy diary bar widget.
#
# Nothing here is interactive. The widget calls these subcommands and reads
# what they print, which keeps every path decision and every word count in one
# place instead of spread through QML, and lets this file be tested on its own
# (test/run-tests.sh).
#
#   diary path [KEY]           absolute path of one entry, created or not
#   diary folder               the diary folder, created if missing
#   diary ensure [KEY] [HEAD]  create the entry if absent, print its path
#   diary stats [KEY]          "<words>\t<first line>" for one entry
#   diary list [LIMIT] [SKIP]  entries newest first, same two columns, SKIP left out
#
# KEY is YYYY-MM-DD and defaults to today. DIARY_DIR overrides the folder
# (default ~/Documents/Diary); a leading ~ or a relative path is expanded
# against $HOME, the same way Diary.resolveDirectory does it in QML.
#
# ensure, stats and list exit 3, before touching any entry, when the folder
# is not private (see private_dir). Any other failure exits 1.

set -uo pipefail

DATE_KEY_RE='^[0-9]{4}-[0-9]{2}-[0-9]{2}$'

fail() {
  printf 'diary: %s\n' "$*" >&2
  exit 1
}

refuse() {
  printf 'diary: %s\n' "$*" >&2
  exit 3
}

usage() {
  cat <<'USAGE'
diary path [KEY]           absolute path of one entry, created or not
diary folder               the diary folder, created if missing
diary ensure [KEY] [HEAD]  create the entry if absent, print its path
diary stats [KEY]          "<words>\t<first line>" for one entry
diary list [LIMIT] [SKIP]  entries newest first, same two columns, SKIP left out

KEY is YYYY-MM-DD and defaults to today.
DIARY_DIR overrides the folder (default ~/Documents/Diary).
USAGE
}

today_key() { date +%Y-%m-%d; }

diary_dir() {
  local dir="${DIARY_DIR:-}"
  [[ -n $dir ]] || dir='~/Documents/Diary'

  case $dir in
  '~') dir=$HOME ;;
  '~/'*) dir="$HOME/${dir#'~/'}" ;;
  esac

  [[ $dir == /* ]] || dir="$HOME/$dir"
  while [[ $dir == */ && $dir != / ]]; do dir=${dir%/}; done
  printf '%s\n' "$dir"
}

# The folder an entry is handed out of has to be one nobody else can change.
#
# A check on the entry itself cannot be enough. The editor is launched after
# this script exits, by pathname, so whoever can create or rename names in the
# folder can swap the entry for a symlink after any check made here and before
# the editor opens (and autosaves) it. stats and list have the same gap: they
# check a name and then reopen it. The gap closes only if no other account can
# change any name the path goes through, so that is checked before an entry is
# touched, and the folder is refused otherwise.
#
# The path is resolved here one component at a time, the way the kernel does
# it, following each symlink in turn, so that every directory a lookup of an
# entry would pass through is seen -- including the ones inside a symlink's
# target, which the logical path never names. Each must be:
#
#   - owned by this user or by root, since an owner can always chmod;
#   - without group or other write permission. On Linux this covers POSIX
#     ACLs too: with an ACL present the group bits of the mode are the ACL
#     mask, which caps every named user and group entry, so any ACL that lets
#     another account write shows up as g+w;
#   - with one exception: a sticky directory above the folder, like /tmp, is
#     fine, because there only the owner of a name can rename or remove it
#     and the owner is checked. The folder itself gets no such exception:
#     sticky or not, others could still create today's entry before we do.
#
# A symlink passed through must also belong to this user or root, which is
# what matters when it sits in a sticky directory.
#
# Prints the resolved, symlink-free folder -- the path every later step must
# use -- or exits 3 (or 1 when the folder cannot be resolved at all).
private_dir() {
  local dir=$1 cur=/ comp next target owner mode name hops=0
  local -a queue more dirs=(/)

  IFS=/ read -r -d '' -a queue < <(printf '%s' "$dir")
  while ((${#queue[@]})); do
    comp=${queue[0]}
    queue=("${queue[@]:1}")
    case $comp in
    '' | .) continue ;;
    ..)
      cur=${cur%/*}
      [[ -n $cur ]] || cur=/
      continue
      ;;
    esac

    next="${cur%/}/$comp"
    if [[ -L $next ]]; then
      ((++hops <= 40)) || fail "too many symlinks in $dir"
      owner=$(stat -c %u -- "$next") || fail "cannot inspect $next"
      [[ $owner == "$EUID" || $owner == 0 ]] ||
        refuse "refusing $dir: $next is a symlink owned by another user"
      target=$(readlink -- "$next") || fail "cannot read $next"
      [[ $target == /* ]] && cur=/
      IFS=/ read -r -d '' -a more < <(printf '%s' "$target")
      queue=("${more[@]}" "${queue[@]}")
      continue
    fi

    [[ -d $next ]] || fail "not a directory: $next"
    cur=$next
    dirs+=("$cur")
  done

  while IFS=' ' read -r -d '' owner mode name; do
    [[ $owner == "$EUID" || $owner == 0 ]] ||
      refuse "refusing $dir: $name is owned by another user"
    mode=$((8#$mode))
    ((mode & 8#022)) || continue
    [[ $name != "$cur" ]] && ((mode & 8#1000)) && continue
    refuse "refusing $dir: $name is writable by other users (chmod go-w '$name')"
  done < <(printf '%s\0' "${dirs[@]}" | sort -zu | xargs -0 stat --printf '%u %a %n\0' --)

  printf '%s\n' "$cur"
}

# A diary is private: every directory this creates, the folder and any parent
# it needs, is 0700 whatever the umask, so a fresh setup always passes
# private_dir. Existing directories are left as they are.
make_dir() {
  (umask 077 && mkdir -p -- "$1")
}

# Puts BODY at FILE only if nothing is there, without ever opening FILE.
#
# The text goes into a fresh mktemp file first (O_EXCL, mode 0600), which is
# then hard-linked into place. link() never follows a symlink at the
# destination and fails if any name is already there, so an entry that
# appeared in the meantime is never truncated and a link planted in the window
# is never written through. (Bash's noclobber is not enough on its own: it
# still opens an existing non-regular file, so a link to a FIFO or a device
# would be written to.) Failure is quiet; the caller checks what is there.
#
# Only a filesystem without hard links (exFAT on a USB stick, say) falls back
# to a noclobber write, and only while nothing at all is at FILE.
create_entry() {
  local file=$1 body=$2 tmp status=1
  tmp=$(mktemp -- "$file.XXXXXX" 2>/dev/null) || return 1
  if printf '%s' "$body" >"$tmp"; then
    if ln -T -- "$tmp" "$file" 2>/dev/null; then
      status=0
    elif [[ ! -e $file && ! -L $file ]]; then
      (set -o noclobber; printf '%s' "$body" >"$file") 2>/dev/null && status=0
    fi
  fi
  rm -f -- "$tmp"
  return "$status"
}

validate_key() {
  [[ $1 =~ $DATE_KEY_RE ]] || fail "invalid date key: $1"
  # 2026-02-31 has the right shape and is not a day: the calendar decides, not
  # the pattern. GNU date normalises it to 2026-03-03, so a round trip that
  # comes back different means the date never existed.
  local roundtrip
  roundtrip=$(date -d "$1" +%Y-%m-%d 2>/dev/null) || fail "invalid date key: $1"
  [[ $roundtrip == "$1" ]] || fail "invalid date key: $1"
}

entry_path() {
  local key=$1
  validate_key "$key"
  printf '%s/%s.md\n' "$(diary_dir)" "$key"
}

# Marks the start of what the author actually wrote. `ensure` writes a heading
# followed by a blank line, so a file in that shape starts at line 3: the
# heading is furniture this widget put there, and counting it as words would
# report every untouched entry as four words long. Any other file counts whole.
body_start_rule='
  { line[NR] = $0 }
  END {
    start = 1
    if (NR >= 2 && line[1] ~ /^# / && line[2] == "") start = 3
    for (i = start; i <= NR; i++) print line[i]
    exit
  }
'

body_words() {
  local file=$1 count
  count=$(
    awk "$body_start_rule" "$file" |
      tr -s '[:space:]' '\n' |
      grep -c '[^[:space:]]'
  ) || count=0
  printf '%s\n' "${count:-0}"
}

# The first line the author wrote, with the markdown markers a one-line panel
# row has no room to render. Tabs and newlines fold to spaces so the result is
# always exactly one TSV field, whatever the file holds.
body_first_line() {
  local file=$1 text
  text=$(
    awk "$body_start_rule" "$file" |
      awk '/[^[:space:]]/ { print; exit }'
  ) || text=""

  printf '%s' "$text" |
    tr '\t\r\n' '   ' |
    sed -e 's/^[[:space:]]*//' \
      -e 's/^[#>*_~`-][#>*_~` -]*//' \
      -e 's/\*\*//g' \
      -e 's/__//g' \
      -e 's/[[:space:]]\{1,\}/ /g' \
      -e 's/[[:space:]]*$//' |
    tr -d '[:cntrl:]'
}

cmd_path() {
  entry_path "${1:-$(today_key)}"
}

cmd_folder() {
  local dir
  dir=$(diary_dir)
  make_dir "$dir" || fail "cannot create $dir"
  printf '%s\n' "$dir"
}

cmd_ensure() {
  local key="${1:-$(today_key)}" header="${2-}" dir file body=""

  validate_key "$key"
  dir=$(diary_dir)

  if [[ -n $header ]]; then
    # One line only. This becomes a markdown heading in a plain text file, and
    # a newline smuggled into it would push the rest of the template into the
    # author's first line.
    header=${header//$'\r'/ }
    header=${header//$'\n'/ }
    body="$header"$'\n\n'
  fi
  # Never a zero-byte file: the writing app treats a file it has not read
  # content from as one that needs an explicit save, so an empty file would
  # quietly disable autosaving for that entry.
  [[ -n $body ]] || body=$'\n'

  make_dir "$dir" 2>/dev/null || fail "cannot create $dir"
  # Nothing below runs unless the folder is private; from here on nobody else
  # can create, rename or replace an entry, so the path printed at the end
  # stays the file this script checked until the editor is done with it.
  dir=$(private_dir "$dir") || exit
  file="$dir/$key.md"

  # Belt and braces, now that only this user can plant anything here: a
  # symlink must never decide where an entry's text lands. Unlink it first --
  # rm removes the link itself and never its target.
  [[ -L $file ]] && rm -f -- "$file"

  if [[ ! -e $file ]]; then
    create_entry "$file" "$body"
  elif [[ -f $file && ! -s $file ]]; then
    # An empty entry has to get content, or the writing app will not autosave
    # it. Unlink and create rather than truncate in place: only creating a new
    # file is guaranteed not to write through whatever the path pointed at.
    rm -f -- "$file"
    create_entry "$file" "$body"
  fi

  # Last word on it, after the race the writes above cannot lose: a link that
  # is still there is not an entry, and handing its path to the editor would
  # let the editor's autosaves run through it.
  [[ ! -L $file ]] || fail "refusing to use a symlinked entry: $file"
  [[ -f $file ]] || fail "cannot write $file"
  printf '%s\n' "$file"
}

cmd_stats() {
  local key="${1:-$(today_key)}" dir file
  validate_key "$key"
  dir=$(diary_dir)
  # Before the first entry the folder may not exist yet: nothing to read, and
  # nothing to refuse.
  if [[ ! -e $dir ]]; then
    printf '0\t\n'
    return 0
  fi
  dir=$(private_dir "$dir") || exit
  file="$dir/$key.md"
  if [[ -f $file && ! -L $file ]]; then
    printf '%s\t%s\n' "$(body_words "$file")" "$(body_first_line "$file")"
  else
    printf '0\t\n'
  fi
}

cmd_list() {
  local limit="${1:-14}" skip="${2:-}" dir name file key

  [[ $limit =~ ^[0-9]+$ ]] || fail "invalid limit: $limit"
  ((limit >= 1 && limit <= 200)) || fail "limit out of range: $limit"
  if [[ -n $skip ]]; then validate_key "$skip"; fi

  dir=$(diary_dir)
  [[ -e $dir ]] || return 0
  dir=$(private_dir "$dir") || exit

  # ISO dates sort as text, so the newest entries come first with no date
  # arithmetic on this side.
  while IFS= read -r name; do
    key=${name%.md}
    # Skipped after the sort rather than inside it: the widget asks for "the
    # last N entries besides today", and today already has its own row.
    [[ -n $skip && $key == "$skip" ]] && continue
    file="$dir/$name"
    printf '%s\t%s\t%s\n' "$key" "$(body_words "$file")" "$(body_first_line "$file")"
  done < <(
    find "$dir" -mindepth 1 -maxdepth 1 -type f \
      -name '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md' -printf '%f\n' |
      sort -r | head -n "$limit"
  )
}

command="${1:-}"
[[ $# -gt 0 ]] && shift

case "$command" in
path) cmd_path "$@" ;;
folder) cmd_folder "$@" ;;
ensure) cmd_ensure "$@" ;;
stats) cmd_stats "$@" ;;
list) cmd_list "$@" ;;
-h | --help | help | "") usage ;;
*) fail "unknown command: $command (try --help)" ;;
esac
